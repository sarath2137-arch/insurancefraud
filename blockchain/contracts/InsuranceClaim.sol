pragma solidity ^0.8.24;
contract InsuranceClaim { address public owner; enum Status { Pending, UnderInvestigation, Approved, Rejected } struct Claim { bytes32 dataHash; bool suspicious; uint8 riskScore; bool verified; uint256 timestamp; Status status; } mapping(string=>Claim) public claims; mapping(string=>bool) public exists; event ClaimSubmitted(string indexed claimId,bytes32 claimHash,bool suspicious,uint8 riskScore,uint256 timestamp); event ClaimVerified(string indexed claimId); event ClaimStatusUpdated(string indexed claimId,Status status); modifier onlyOwner(){require(msg.sender==owner,'Unauthorized');_;} constructor(){owner=msg.sender;} function registerClaim(string calldata id,bytes32 hash,bool suspicious,uint8 score) external onlyOwner {require(!exists[id],'Exists');require(score<=100,'Score');claims[id]=Claim(hash,suspicious,score,false,block.timestamp,Status.Pending);exists[id]=true;emit ClaimSubmitted(id,hash,suspicious,score,block.timestamp);} function verifyClaim(string calldata id) external onlyOwner {require(exists[id],'Missing');claims[id].verified=true;emit ClaimVerified(id);} function updateStatus(string calldata id,Status status) external onlyOwner {require(exists[id],'Missing');claims[id].status=status;emit ClaimStatusUpdated(id,status);} }
